{
    "manifest_version":  3,
    "name":  "Recordly - Studio Screen Recorder",
    "version":  "1.0.0",
    "description":  "Studio-quality screen recorder with presentation effects, vocal separation, background noise cleaner, and smooth smart zoom.",
    "permissions":  [
                        "storage",
                        "tabs"
                    ],
    "action":  {
                   "default_popup":  "popup.html",
                   "default_icon":  {
                                        "16":  "assets/icon-16.png",
                                        "48":  "assets/icon-48.png",
                                        "128":  "assets/icon-128.png"
                                    }
               },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "icons":  {
                  "16":  "assets/icon-16.png",
                  "48":  "assets/icon-48.png",
                  "128":  "assets/icon-128.png"
              },
    "commands":  {
                     "open-studio":  {
                                         "suggested_key":  {
                                                               "default":  "Ctrl+Shift+R",
                                                               "mac":  "Command+Shift+R"
                                                           },
                                         "description":  "Open Recordly Studio"
                                     }
                 },
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "studio.js",
                                                           "assets/*"
                                                       ],
                                         "matches":  [
                                                         "\u003call_urls\u003e"
                                                     ]
                                     }
                                 ],
    "content_security_policy":  {
                                    "extension_pages":  "script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027; object-src \u0027self\u0027"
                                }
}