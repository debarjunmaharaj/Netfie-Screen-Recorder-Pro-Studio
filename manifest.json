{
    "manifest_version":  3,
    "name":  "Recordly - Studio Screen Recorder",
    "version":  "1.0.0",
    "description":  "Studio-quality screen recorder with presentation effects, vocal separation, background noise cleaner, and smooth smart zoom.",
    "permissions":  [
                        "storage",
                        "tabs"
                    ],
    "action":  {
                   "default_popup":  "popup.html",
                   "default_icon":  {
                                        "16":  "assets/icon-16.png",
                                        "48":  "assets/icon-48.png",
                                        "128":  "assets/icon-128.png"
                                    }
               },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "icons":  {
                  "16":  "assets/icon-16.png",
                  "48":  "assets/icon-48.png",
                  "128":  "assets/icon-128.png"
              },
    "commands":  {
                     "open-studio":  {
                                         "suggested_key":  {
                                                               "default":  "Ctrl+Shift+R",
                                                               "mac":  "Command+Shift+R"
                                                           },
                                         "description":  "Open Recordly Studio"
                                     }
                 }
}